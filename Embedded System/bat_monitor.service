[Unit]
Description=Bat Activity Monitoring System
Documentation=https://github.com/yourusername/bat-monitor
After=network.target network-online.target
Wants=network-online.target
# Give up after 5 crashes in 200s
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/bat-monitor
Environment="PATH=/home/pi/bat-monitor/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/pi/bat-monitor/venv/bin/python3 /home/pi/bat-monitor/main.py

# Restart policy
Restart=on-failure
# Time to finish tonight's report email when stopped
TimeoutStopSec=120
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bat-monitor

# Security
# (NoNewPrivileges is not set: setting the clock and WiFi from the UI uses sudo)
PrivateTmp=true

# Resource limits
MemoryMax=400M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
